# Flight Monitor 环境变量示例。只填本机/部署环境，不得提交真实值。

# ===== 当前经济舱主源（有效监控必需） =====
JUHE_FLIGHT_KEY=

# ===== 通知渠道（至少配置一种） =====
PUSHPLUS_TOKEN=
SMTP_PROVIDER=qq
# SMTP_PROVIDER: qq / 163 / gmail
SMTP_USER=
SMTP_PASS=
# 自定义SMTP时取消注释；SMTP_SSL支持 true/false。
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SSL=true

# 手工邮件连通性测试收件地址（非生产必需）
TEST_EMAIL_TO=

# ===== 商务舱/混舱（可选；三个别名只填一个） =====
SERPAPI_KEY=
# SERPAPI_API_KEY=
# SERP_API_KEY=

# ===== 候选规则富化（可选） =====
DUFFEL_TOKEN=

# ===== PythonAnywhere同步（可选） =====
PYTHONANYWHERE_TOKEN=
PYTHONANYWHERE_USER=
SUBSCRIPTION_FORM_URL=
# 可选：开启详情页共享令牌校验；留空即关闭。
SHARED_DETAIL_TOKEN=
# 兼容旧部署链接；新部署优先填SUBSCRIPTION_FORM_URL。
# PYTHONANYWHERE_FORM_URL=

# ===== Web会话与写操作安全 =====
# PythonAnywhere部署必须填写固定高熵值；本地留空会生成仅限开发兜底的临时值。
FLASK_SECRET_KEY=
# 本地HTTP保持0；PythonAnywhere HTTPS部署必须置1。
SESSION_COOKIE_SECURE=0
# CSRF token有效期与首次采集启动握手等待上限。
# CSRF_TOKEN_TTL_SECONDS=7200
# COLLECTION_STARTUP_TIMEOUT_SECONDS=3

# ===== 表单反馈（可选） =====
FEEDBACK_NOTIFY_EMAIL=

# ===== 测试与受控审计安全开关 =====
# 仅供 CI、离线测试与受控审计使用;只有精确值 1 生效。
# 正常本地订阅轮不得启用:启用后 SMTP 与 PushPlus 公共发送入口会在建立网络连接与派生内容之前返回 False,
# 并记录不含动态内容的固定拒绝日志;上层流程可能记录通知失败或继续其他渠道,不以异常形式中止。
# 生产或 PA 环境仅在明确需要禁用这两个出口、且理解本开关不保护 PA Files/Juhe/SerpAPI/Duffel 时才可显式启用。
# 完整覆盖边界见 docs/external-network-no-live-api-coverage-2026-09-03.md
# NO_LIVE_API=1

# ===== 采集与诊断覆盖（通常保持默认） =====
# 同机多进程采集单飞锁；生产环境建议填写主运行目录中的绝对路径。
# linked Git worktree未配置时会自动共用主工作区路径。
# COLLECTION_LOCK_PATH=C:/path/to/flight-monitor/data/collection_singleflight.lock
# JUHE_FLIGHT_ENDPOINT=https://apis.juhe.cn/flight/query
# JUHE_ONTIME_ENDPOINT=
# JUHE_QUOTA_CODES=112,10012
# BASKET_SENTINEL_AFTER=20:00
# CHECK_INTERVAL_HOURS=6
# FLIGHT_DEBUG_FULL_ARRAYS=0

# ===== 统计门槛（通常保持默认） =====
# MIN_SAMPLE_FOR_PRICE_SIGNAL=5
# MIN_SAMPLE_FOR_TCURVE=5
# TCURVE_MIN_CELLS=3
# AGREEMENT_WINDOW_DAYS=30
# MIN_PAIRS_FOR_AGREEMENT=10
# MIN_PATTERN_N=5
# MIN_OBS_FOR_LEVEL=4
# MIN_BACKTEST_CASES=5
# SKILL_GATE_IMPROVEMENT=0.10
# HOLIDAY_SHOULDER_DAYS=1

# ===== 离线工具（可选） =====
# SNAPSHOT_DEPART_DATE=2026-12-01
# SNAPSHOT_RETURN_DATE=2026-12-08
# BROWSER_PATH=
# Windows 本地兼容旧变量；新配置优先使用 BROWSER_PATH。
# EDGE_PATH=
