# 复制此文件为 .env 并填入真实key
SERPAPI_KEY=your_serpapi_key_here
SEARCHAPI_KEY=your_searchapi_key_here
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here
RAPIDAPI_KEY=your_rapidapi_key_here
DUFFEL_TOKEN=your_duffel_access_token_here
PYTHONANYWHERE_TOKEN=your_pythonanywhere_api_token_here
PYTHONANYWHERE_USER=ljs96824
PUSHPLUS_TOKEN=your_pushplus_token_here
WECOM_WEBHOOK=your_wecom_webhook_here（可选）
SMTP_PROVIDER=qq
# SMTP_PROVIDER 可选: qq / 163 / gmail
# Gmail需要开启两步验证并生成App Password；国内网络通常无法直连smtp.gmail.com。
# 如需手动覆盖服务商默认值，可设置 SMTP_HOST / SMTP_PORT / SMTP_SSL。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SSL=true
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code
TEST_EMAIL_TO=your_receive_email@example.com
